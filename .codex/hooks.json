{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$(git rev-parse --show-toplevel)/.codex/guard.py\"",
            "timeout": 10,
            "statusMessage": "project command rules"
          }
        ]
      }
    ]
  }
}
