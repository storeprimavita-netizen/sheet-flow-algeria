{
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force*)",
      "Bash(git push * main*)",
      "Bash(git reset --hard *)",
      "Bash(npx supabase db push *)",
      "Bash(supabase db push *)",
      "Bash(npx supabase db reset --linked *)",
      "Bash(npx supabase link *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v graphify >/dev/null 2>&1 && exec graphify hook-guard search || exit 0'"
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'command -v graphify >/dev/null 2>&1 && exec graphify hook-guard read || exit 0'"
          }
        ]
      }
    ]
  }
}
