# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# graphify knowledge graph (regenerated locally)
/graphify-out/

# supabase local CLI temp
/supabase/.temp/

# business reference sheets (kept local)
*.xlsx
supabase/.branches/
supabase/.temp/

# Playwright MCP transient output
.playwright-mcp/

# local scratch — never commit (kimi.tx holds an API key)
kimi*
.playwright-mcp/
/*.png

# loop v3: parallel worktrees + owner drop folder (source material, superseded by skills/specs)
/.worktrees/
/THEME+CALCULATOR/
/prices/

# night run flag for the Codex stop hook (.codex/night-stop.py)
/.night-run
/.no-claude-review
